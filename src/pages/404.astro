---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { localePath, t } from '../i18n';

const locale = 'en';
---
<Base locale={locale} path="/404/" noindex title={t(locale, 'error.notFound.title')} description={t(locale, 'error.notFound.body')}>
  <section class="lost section" data-theme="night">
    <div class="lanterns" aria-hidden="true">
      <span class="lantern" style="--x:14%;--y:20%;--s:.7;--d:8;--delay:1;--dx:12;--dy:-30;--o:.7;--b:1"><i></i></span>
      <span class="lantern" style="--x:80%;--y:30%;--s:.5;--d:7;--delay:3;--dx:-10;--dy:-26;--o:.6;--b:2"><i></i></span>
    </div>
    <div class="wrap">
      <p class="lost__code" aria-hidden="true">404</p>
      <h1>{t(locale, 'error.notFound.title')}</h1>
      <p>{t(locale, 'error.notFound.body')}</p>
      <div class="lost__actions">
        <a class="btn btn--glow" href={localePath(locale, '/')}>{t(locale, 'error.notFound.home')}</a>
        <a class="btn btn--ghost" href={localePath(locale, '/designs/')}>{t(locale, 'error.notFound.designs')}<Icon name="right" /></a>
      </div>
    </div>
  </section>
</Base>
