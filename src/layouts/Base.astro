---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/noto-sans-sinhala/wght.css';
import '@fontsource-variable/noto-sans-tamil/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { defaultLocale, localePath, localeTag, locales, runtimeMessages, t, type Locale } from '../i18n';

interface Props { locale: Locale; path: string; title: string; description: string; home?: boolean; noindex?: boolean; }
const { locale, path, title, description, home = false, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://serendib.tech');
const canonical = new URL(localePath(locale, path), site).href;
const og = new URL('/og.jpg', site).href;
const runtime = JSON.stringify(runtimeMessages(locale)).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={localeTag[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && locales.map((code) => <link rel="alternate" hreflang={code} href={new URL(localePath(code, path), site).href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale, path), site).href} />}
    <meta name="theme-color" content="#0b0820" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WebBlitz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={t(locale, 'meta.social.alt')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content={localeTag[locale].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={t(locale, 'meta.social.alt')} />
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){document.documentElement.classList.add('motion-failsafe')},3000);</script>
  </head>
  <body data-theme="night">
    <a class="skip" href="#main">{t(locale, 'nav.skip')}</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
    <div class="cursor-glow" aria-hidden="true" data-cursor></div>
    <Header locale={locale} path={path} home={home} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer locale={locale} />
    <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" aria-label={t(locale, 'showcase.pause.label')} hidden>
      <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" /><span data-motion-text>{t(locale, 'showcase.pause')}</span>
    </button>
    <script type="application/json" id="wb-runtime" set:html={runtime}></script>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
