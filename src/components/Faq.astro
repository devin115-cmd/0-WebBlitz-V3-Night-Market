---
import Icon from './Icon.astro';
import Split from './Split.astro';
import { legalBaseUrl } from '../data/site';
import { factValues } from '../i18n/facts';
import { localePath, t, type Locale, type MessageKey } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const values = factValues(locale);
const items = ['included', 'languages', 'domain', 'content', 'delivery', 'corrections', 'demos', 'enquiry'];
---
<section class="faq section" data-theme="cream" id="faq" data-section>
  <div class="wrap faq__grid">
    <div class="faq__intro">
      <p class="eyebrow">{t(locale, 'faq.eyebrow')}</p>
      <h2 class="section-title" data-split><Split text={t(locale, 'faq.title')} /></h2>
      <p class="gap-top"><a class="link-arrow" href={`${legalBaseUrl}${localePath(locale, '/terms/')}`}>{t(locale, 'faq.more')}<Icon name="arrow" /></a></p>
    </div>
    <div data-reveal-group>
      {items.map((item, index) => (
        <details class="qa" name="faq" open={index === 0} data-reveal>
          <summary>{t(locale, `faq.${item}.question` as MessageKey)}<span class="qa__icon" aria-hidden="true"></span></summary>
          <p class="qa__a">{t(locale, `faq.${item}.answer` as MessageKey, values)}</p>
        </details>
      ))}
    </div>
  </div>
</section>
